# Database Connection (Default SQLite for instant local run, switch to PostgreSQL for Neon/Supabase)
DATABASE_URL="file:./dev.db"

# Authentication & Session Security (Must be at least 32 characters in production)
JWT_SECRET="esitesz-saas-secret-jwt-key-production-strength-2026-xyz"

# Super Admin Authorization (Comma-separated emails that get SUPER_ADMIN access)
SUPER_ADMIN_EMAILS="admin@esitesz.com,super@esitesz.com"

# Public App Metadata
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="esitesz"

# Email / SMTP Configuration (Optional - in dev mode OTPs are printed to terminal and returned in response for testing)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="noreply@esitesz.com"
# SMTP_PASS="secret"
# SMTP_FROM="esitesz Platform <noreply@esitesz.com>"
