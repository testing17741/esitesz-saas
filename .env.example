# ==========================================
# ESITESZ SAAS — PRODUCTION CONFIGURATION
# ==========================================

# Database Connection (Default SQLite for instant local run, switch to PostgreSQL for Neon / Supabase / Vercel Postgres)
DATABASE_URL="file:./dev.db"

# Authentication & Session Security (Must be at least 32 characters in production)
JWT_SECRET="esitesz-saas-production-jwt-key-2026-min-32chars-secure"

# Super Admin Authorization (Comma-separated emails with unrestricted platform admin rights)
SUPER_ADMIN_EMAILS="testing17741@gmail.com,admin@esitesz.com"

# Public App Metadata
NEXT_PUBLIC_APP_URL="https://esitesz-saas.vercel.app"
NEXT_PUBLIC_BRAND_NAME="esitesz"

# ==========================================
# TRANSACTIONAL EMAIL CONFIGURATION (OTP DELIVERY)
# ==========================================
# Option 1: Gmail SMTP (Free, 500 emails/day)
# Use your Gmail address and a 16-character App Password (Google Account > Security > 2-Step Verification > App Passwords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="testing17741@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="esitesz <testing17741@gmail.com>"

# Option 2: Resend API (Alternative: free 100 emails/day, paste your API key from resend.com)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="esitesz <auth@esitesz.com>"
